PIPELINE_FIXER_CONFIG=config/pipeline-fixer.yaml
PIPELINE_FIXER_STATE=var/pipeline-fixer-state.json
# App log level: trace|debug|info|warn|error|fatal|silent (default: info).
# Controls Hootline's own logs; EVE_LOG_LEVEL controls Eve framework logs.
PIPELINE_FIXER_LOG_LEVEL=info
PIPELINE_FIXER_MODEL_PROVIDER=anthropic
PIPELINE_FIXER_MODEL=claude-sonnet-4-6
PIPELINE_FIXER_MODEL_CONTEXT_WINDOW_TOKENS=
PIPELINE_FIXER_MODEL_API_KEY=
PIPELINE_FIXER_MODEL_BASE_URL=
PIPELINE_FIXER_MODEL_PROVIDER_NAME=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_SIGNING_TOKEN=
