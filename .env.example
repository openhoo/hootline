HOOTLINE_STATE_PATH=var/hootline-state.json
HOOTLINE_REPO_CONFIG_PATH=.hootline.yaml
HOST=127.0.0.1
PORT=3000
# App log level: trace|debug|info|warn|error|fatal|silent (default: info).
# Controls Hootline's own logs; EVE_LOG_LEVEL controls Eve framework logs.
HOOTLINE_LOG_LEVEL=info
HOOTLINE_TELEMETRY_MODE=local+otlp
HOOTLINE_TELEMETRY_DETAIL=full
HOOTLINE_TELEMETRY_PATH=var/hootline-telemetry.jsonl
HOOTLINE_TELEMETRY_MAX_TEXT_CHARS=12000
# Optional. When set with HOOTLINE_TELEMETRY_MODE=local+otlp or otlp, Hootline
# exports OpenTelemetry spans/metrics through the OTLP HTTP exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
HOOTLINE_MODEL_PROVIDER=anthropic
HOOTLINE_MODEL=claude-sonnet-4-6
HOOTLINE_MODEL_CONTEXT_WINDOW_TOKENS=
HOOTLINE_MODEL_API_KEY=
HOOTLINE_MODEL_BASE_URL=
HOOTLINE_MODEL_PROVIDER_NAME=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

HOOTLINE_PROVIDER_ERROR_RETRIES=2
HOOTLINE_PROVIDER_ERROR_RETRY_BASE_MS=1000
HOOTLINE_PROVIDER_ERROR_RETRY_MAX_MS=15000

HOOTLINE_GITHUB_PROVIDER_BACKEND=api
HOOTLINE_SIMULATOR_STATE_PATH=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_SIGNING_TOKEN=
GITLAB_SECRET_TOKEN=
