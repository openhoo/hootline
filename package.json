{
  "name": "hootline",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "eve dev --no-ui",
    "info": "eve info",
    "build": "eve build",
    "start": "eve start",
    "check:model-matrix": "node scripts/check-model-matrix.mjs",
    "benchmark:sim": "node scripts/simulated-benchmark.mjs",
    "benchmark:sim:dry-run": "node scripts/simulated-benchmark.mjs --dry-run",
    "github-app:check-installation": "node scripts/github-app-check-installation.mjs",
    "github-app:setup": "node scripts/github-app-manifest-flow.mjs",
    "lint": "npm run typecheck && node scripts/lint-repo.mjs",
    "session:inspect": "node scripts/inspect-eve-session.mjs",
    "typecheck": "tsc --noEmit",
    "test": "HOOTLINE_LOG_LEVEL=silent HOOTLINE_TELEMETRY_MODE=off tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.3",
    "@ai-sdk/openai": "^4.0.4",
    "@ai-sdk/openai-compatible": "^3.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "ai": "^7.0.8",
    "eve": "^0.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tar": "^7.5.21",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
