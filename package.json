{
  "name": "hootline",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "eve dev --no-ui",
    "info": "eve info",
    "build": "eve build",
    "start": "eve start",
    "check:model-matrix": "node scripts/check-model-matrix.mjs",
    "fixture:benchmark": "node scripts/fixture-benchmark.mjs",
    "fixture:reset": "node scripts/reset-pipeline-fixture.mjs",
    "github-app:check-installation": "node scripts/github-app-check-installation.mjs",
    "github-app:setup": "node scripts/github-app-manifest-flow.mjs",
    "lint": "npm run typecheck && node scripts/lint-repo.mjs",
    "session:inspect": "node scripts/inspect-eve-session.mjs",
    "typecheck": "tsc --noEmit",
    "test": "HOOTLINE_LOG_LEVEL=silent tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.3",
    "@ai-sdk/openai": "^4.0.4",
    "@ai-sdk/openai-compatible": "^3.0.2",
    "ai": "^7.0.8",
    "eve": "^0.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tar": "^7.5.19",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
