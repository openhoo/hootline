{
  "name": "hootline-support-desk-fixture",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' --filter './apps/*' build",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck",
    "test": "bun run --filter './packages/*' --filter './apps/*' test",
    "verify": "bun run typecheck && bun run build && bun run test"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
